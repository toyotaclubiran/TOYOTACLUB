# Copy to .env for local experiments. On Netlify, set these in Site settings → Environment.
# Prices stay off until SHOW_PRICES=true and each product has a numeric price in data/catalog.js.
SHOW_PRICES=false
PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
IDPAY_API_KEY=
IDPAY_SANDBOX=true
# Set to true in production so only Torob's signed requests can read the feed.
TOROB_REQUIRE_TOKEN=false
PUBLIC_BASE_URL=https://toyotaclubiran.com
